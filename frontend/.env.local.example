NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set true for QA/E2E: email+password form on /login (bypasses Google OAuth UI).
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=false
# Same value as the backend VAPID_PUBLIC_KEY; empty disables web push opt-in.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# Google Analytics 4 measurement ID (G-XXXX); empty disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Dev-only: show the canned weekly analysis on /home.
NEXT_PUBLIC_ENABLE_WEEKLY_DEMO=false
